{
  "rules": {
    ".read": false,
    ".write": false,

    "participants": {
      ".read": "auth != null && auth.token.admin === true",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.admin === true)",
        ".write": "auth != null && (auth.token.admin === true || (auth.uid === $uid && newData.child('session').val() === root.child('control/active_session').val()))",
        ".validate": "newData.hasChildren(['created_at'])",
        "created_at":     { ".validate": "newData.isNumber()" },
        "session":        { ".validate": "newData.isString()" },
        "participant_no": { ".validate": "newData.isString() && newData.val().length <= 80" },
        "fields": {
          ".validate": "newData.hasChildren()",
          "$fid": {
            ".validate": "newData.isString() || newData.hasChildren()",
            "$i": { ".validate": "newData.isString()" }
          }
        },
        "fields_ts":      { ".validate": "newData.isNumber()" },
        "progress":       { ".validate": true },
        "$other":         { ".validate": false }
      }
    },

    "word_responses": {
      ".read": "auth != null && auth.token.admin === true",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.admin === true)",
        ".write": "auth != null && ($uid === auth.uid || auth.token.admin === true)",
        "$prompt_id": {
          ".validate": "newData.hasChildren(['words','ts']) && newData.child('session').val() === root.child('control/active_session').val()",
          "words": {
            ".validate": "newData.hasChildren()",
            "$i": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" }
          },
          "session": { ".validate": "newData.isString()" },
          "ts":      { ".validate": "newData.isNumber()" },
          "$other":  { ".validate": false }
        }
      }
    },

    "assessments": {
      ".read": "auth != null && auth.token.admin === true",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.admin === true)",
        ".write": "auth != null && ($uid === auth.uid || auth.token.admin === true)",
        "$stim": {
          ".validate": "newData.hasChildren(['clarity','usefulness','trust','ts']) && newData.child('session').val() === root.child('control/active_session').val()",
          "clarity":    { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 7" },
          "usefulness": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 7" },
          "trust":      { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 7" },
          "session":    { ".validate": "newData.isString()" },
          "ts":         { ".validate": "newData.isNumber()" },
          "$other":     { ".validate": false }
        }
      }
    },

    "choices": {
      ".read": "auth != null && auth.token.admin === true",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.admin === true)",
        ".write": "auth != null && ($uid === auth.uid || auth.token.admin === true)",
        "$qid": {
          ".validate": "newData.hasChildren(['type','session','ts']) && (newData.hasChild('choice_idx') || newData.hasChild('choice_idxs')) && newData.child('session').val() === root.child('control/active_session').val()",
          "type":       { ".validate": "newData.val() === 'single_choice' || newData.val() === 'multiple_choice'" },
          "choice_idx": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "choice_idxs": {
            ".validate": "newData.hasChildren()",
            "$i": { ".validate": "newData.isNumber() && newData.val() >= 0" }
          },
          "other_text": { ".validate": "newData.isString() && newData.val().length <= 500" },
          "session":    { ".validate": "newData.isString()" },
          "ts":         { ".validate": "newData.isNumber()" },
          "$other":     { ".validate": false }
        }
      }
    },

    "participant_seq": {
      "$session": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "newData.isNumber() && newData.val() >= 0"
      }
    },

    "presence": {
      ".read": "auth != null && auth.token.admin === true",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.isBoolean()"
      }
    },

    "sessions": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.admin === true",
      "$name": {
        ".validate": "newData.hasChildren(['created_at'])",
        "created_at": { ".validate": "newData.isNumber()" },
        "active":     { ".validate": "newData.isBoolean()" },
        "$other":     { ".validate": false }
      }
    },

    "control": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.admin === true",
      "session":        { ".validate": "newData.isString()" },
      "active_session": { ".validate": "newData.isString()" },
      "reset":          { ".validate": "newData.isNumber()" },
      "gating_enabled": { ".validate": "newData.isBoolean()" },
      "pres": {
        "$section_id": {
          ".validate": "newData.hasChildren(['idx'])",
          "idx":          { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "likert_shown": { ".validate": "newData.isBoolean()" },
          "$other":       { ".validate": false }
        }
      },
      "back_questionnaire": { ".validate": "newData.isBoolean()" },
      "back_end":        { ".validate": "newData.isBoolean()" },
      "section_gates":  { "$section_id": { ".validate": "newData.isString()" } },
      "broadcast": {
        ".validate": "newData.hasChild('ts') && (newData.hasChild('text') || newData.hasChild('image'))",
        "text":   { ".validate": "newData.isString() && newData.val().length <= 500" },
        "image":  { ".validate": "newData.isString() && newData.val().length <= 1400000" },
        "label":  { ".validate": "newData.isString() && newData.val().length <= 200" },
        "locked": { ".validate": "newData.isBoolean()" },
        "ts":     { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      },
      "word_cleaning": {
        "$session": {
          "$prompt": {
            ".validate": "newData.hasChild('ts')",
            "ts":    { ".validate": "newData.isNumber()" },
            "model": { ".validate": "newData.isString() && newData.val().length <= 80" },
            "removed": {
              "$term": {
                "reason":     { ".validate": "newData.isString() && newData.val().length <= 200" },
                "overridden": { ".validate": "newData.isBoolean()" },
                "$other":     { ".validate": false }
              }
            },
            "merges": {
              "$canon": {
                "canonical":  { ".validate": "newData.isString()" },
                "overridden": { ".validate": "newData.isBoolean()" },
                "members":    { "$m": { ".validate": "newData.isBoolean()" } },
                "split":      { "$m": { ".validate": "newData.isBoolean()" } },
                "$other":     { ".validate": false }
              }
            },
            "$other": { ".validate": false }
          }
        }
      },
      "force_section": {
        ".validate": "newData.hasChildren(['section_id','session','ts'])",
        "section_id": { ".validate": "newData.isString()" },
        "session":    { ".validate": "newData.isString()" },
        "ts":         { ".validate": "newData.isNumber()" },
        "$other":     { ".validate": false }
      },
      "warnings": { "$other": { ".validate": true } }
    }
  }
}
