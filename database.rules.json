{
  "rules": {
    ".read": false,
    ".write": false,

    "participants": {
      ".read": "auth != null && auth.token.admin === true",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.admin === true)",
        ".write": "auth != null && (auth.uid === $uid || auth.token.admin === true)",
        ".validate": "newData.hasChildren(['created_at'])",
        "created_at":     { ".validate": "newData.isNumber()" },
        "session":        { ".validate": "newData.isString()" },
        "participant_no": { ".validate": "newData.isString() && newData.val().length <= 80" },
        "fields":         { ".validate": "newData.hasChildren()" },
        "fields_ts":      { ".validate": "newData.isNumber()" },
        "consent":        { ".validate": "newData.hasChildren(['version','ts'])" },
        "progress":       { ".validate": true },
        "$other":         { ".validate": false }
      }
    },

    "word_responses": {
      ".read": "auth != null && auth.token.admin === true",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.admin === true)",
        ".write": "auth != null && ($uid === auth.uid || auth.token.admin === true)",
        "$prompt_id": {
          ".validate": "newData.hasChildren(['words','ts'])",
          "words": {
            ".validate": "newData.hasChildren()",
            "$i": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" }
          },
          "session": { ".validate": "newData.isString()" },
          "ts":      { ".validate": "newData.isNumber()" },
          "$other":  { ".validate": false }
        }
      }
    },

    "assessments": {
      ".read": "auth != null && auth.token.admin === true",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.admin === true)",
        ".write": "auth != null && ($uid === auth.uid || auth.token.admin === true)",
        "$stim": {
          ".validate": "newData.hasChildren(['comprehension','usefulness','access','trust','ts'])",
          "comprehension": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 10" },
          "usefulness":    { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 10" },
          "access":        { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 10" },
          "trust":         { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 10" },
          "session":       { ".validate": "newData.isString()" },
          "ts":            { ".validate": "newData.isNumber()" },
          "$other":        { ".validate": false }
        }
      }
    },

    "choices": {
      ".read": "auth != null && auth.token.admin === true",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.admin === true)",
        ".write": "auth != null && ($uid === auth.uid || auth.token.admin === true)",
        "$qid": {
          ".validate": "newData.hasChildren(['type','session','ts']) && (newData.hasChild('choice_idx') || newData.hasChild('choice_idxs'))",
          "type":       { ".validate": "newData.val() === 'single_choice' || newData.val() === 'multiple_choice'" },
          "choice_idx": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "choice_idxs": {
            ".validate": "newData.hasChildren()",
            "$i": { ".validate": "newData.isNumber() && newData.val() >= 0" }
          },
          "other_text": { ".validate": "newData.isString() && newData.val().length <= 500" },
          "session":    { ".validate": "newData.isString()" },
          "ts":         { ".validate": "newData.isNumber()" },
          "$other":     { ".validate": false }
        }
      }
    },

    "participant_seq": {
      "$session": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "newData.isNumber() && newData.val() >= 0"
      }
    },

    "control": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.admin === true",
      "session":        { ".validate": "newData.isString()" },
      "gating_enabled": { ".validate": "newData.isBoolean()" },
      "presentation_idx": { ".validate": "newData.isNumber()" },
      "back_questionnaire": { ".validate": "newData.isBoolean()" },
      "back_end":        { ".validate": "newData.isBoolean()" },
      "section_gates":  { "$section_id": { ".validate": "newData.isString()" } },
      "broadcast": {
        ".validate": "newData.hasChildren(['text','ts'])",
        "text":   { ".validate": "newData.isString() && newData.val().length <= 500" },
        "ts":     { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      },
      "force_section": {
        ".validate": "newData.hasChildren(['section_id','session','ts'])",
        "section_id": { ".validate": "newData.isString()" },
        "session":    { ".validate": "newData.isString()" },
        "ts":         { ".validate": "newData.isNumber()" },
        "$other":     { ".validate": false }
      },
      "warnings": { "$other": { ".validate": true } }
    }
  }
}
